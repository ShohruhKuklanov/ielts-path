{
  "name": "ielts-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "web": "pnpm --filter mobile web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:start": "node scripts/sync-shared.mjs && supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "fix-deps": "pnpm --filter mobile exec expo install --fix",
    "admin": "pnpm --filter admin dev",
    "sync:shared": "node scripts/sync-shared.mjs",
    "content:build": "node --experimental-strip-types --no-warnings scripts/build-content-sql.mts",
    "content:load": "pnpm content:build && docker exec -i supabase_db_ielts-app psql -q -v ON_ERROR_STOP=1 -U postgres -d postgres < supabase/seed.sql"
  },
  "devDependencies": {
    "supabase": "^2.40.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
