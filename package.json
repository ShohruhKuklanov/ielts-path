{
  "name": "ielts-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "web": "pnpm --filter mobile web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "fix-deps": "pnpm --filter mobile exec expo install --fix"
  },
  "devDependencies": {
    "supabase": "^2.40.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
