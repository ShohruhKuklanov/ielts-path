{
  "title": "Long vowel sounds",
  "kind": "phonics",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Vowels can also have a long sound."
    },
    {
      "type": "text",
      "text": "Two letters together often make one long sound."
    },
    {
      "type": "table",
      "rows": [
        [
          "ee",
          "see",
          "sheep"
        ],
        [
          "ar",
          "car",
          "park"
        ],
        [
          "oo",
          "food",
          "blue"
        ],
        [
          "or",
          "door",
          "four"
        ],
        [
          "ir",
          "bird",
          "girl"
        ]
      ]
    },
    {
      "type": "example",
      "en": "ship — sheep",
      "note": "short i — long ee"
    },
    {
      "type": "example",
      "en": "full — fool",
      "note": "short u — long oo"
    },
    {
      "type": "tip",
      "text": "Make long sounds longer: sheeeep. Make short sounds quick: ship."
    }
  ],
