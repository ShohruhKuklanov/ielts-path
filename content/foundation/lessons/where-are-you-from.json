  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Countries"
    },
    {
      "type": "table",
      "rows": [
        [
          "Uzbekistan",
          "Kazakhstan",
          "Russia"
        ],
        [
          "Turkey",
          "China",
          "India"
        ],
        [
          "the UK",
          "the USA",
          "Japan"
        ],
        [
          "Korea"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Asking and answering"
    },
    {
      "type": "example",
      "en": "Where are you from?",
      "note": "the question"
    },
    {
      "type": "example",
      "en": "I'm from Uzbekistan.",
      "note": "I am + from + country"
    },
    {
      "type": "example",
      "en": "Where is he from? — He is from India."
    },
    {
      "type": "heading",
      "text": "3. Grammar focus"
    },
    {
      "type": "rule",
      "title": "be + from",
      "points": [
        "I am from …, You are from …, He / She is from …",
        "Do not forget be: I am from Japan. (not I from Japan)"
      ]
    },
    {
      "type": "rule",
      "title": "the with some countries",
      "points": [
        "We say the UK and the USA (they are groups of states).",
        "Most countries have no the: Japan, China, Turkey."
      ]
    },
    {
      "type": "rule",
      "title": "Capital letters",
      "points": [
        "Countries and cities always start with a capital letter: India, Samarkand."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I from Turkey.",
      "right": "I'm from Turkey.",
      "why": "Do not forget am."
    },
    {
      "type": "mistake",
      "wrong": "I am from USA.",
      "right": "I am from the USA."
    },
    {
      "type": "mistake",
      "wrong": "She is from china.",
      "right": "She is from China.",
      "why": "capital letter"
    }
  ],
