{
  "title": "Daily routines",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Things we do every day"
    },
    {
      "type": "table",
      "rows": [
        [
          "get up",
          "have a shower",
          "get dressed"
        ],
        [
          "have breakfast",
          "go to work / school",
          "have lunch"
        ],
        [
          "come home",
          "do homework",
          "have dinner"
        ],
        [
          "watch TV",
          "go to bed",
          "sleep"
        ]
      ]
    },
    {
      "type": "example",
      "en": "I get up at 7 o'clock."
    },
    {
      "type": "example",
      "en": "I go to bed at 11."
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: collocations"
    },
    {
      "type": "rule",
      "title": "have + meals and some actions",
      "points": [
        "have breakfast / lunch / dinner",
        "have a shower",
        "(not eat breakfast usually, not take breakfast)"
      ]
    },
    {
      "type": "rule",
      "title": "go to …",
      "points": [
        "go to school / go to work / go to bed — no the",
        "go home — no to: I go home at 6."
      ]
    },
    {
      "type": "rule",
      "title": "Order words",
      "points": [
        "first, then, after that, finally: First I get up. Then I have breakfast."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I go to the school.",
      "right": "I go to school."
    },
    {
      "type": "mistake",
      "wrong": "I go to home.",
      "right": "I go home."
    },
    {
      "type": "mistake",
      "wrong": "I take breakfast.",
      "right": "I have breakfast."
    }
  ],
