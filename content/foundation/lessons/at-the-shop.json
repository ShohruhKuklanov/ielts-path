{
  "title": "At the shop",
  "kind": "speaking",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Useful phrases"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "you want to …",
          "you say"
        ],
        [
          "ask for something",
          "Can I have a bottle of water, please?"
        ],
        [
          "ask the price",
          "How much is it? / How much are they?"
        ],
        [
          "ask about size or colour",
          "Do you have this in blue / in a bigger size?"
        ],
        [
          "decide",
          "I'll take it."
        ],
        [
          "say thank you",
          "Thank you. / Thanks."
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "the shop assistant says",
          "meaning"
        ],
        [
          "Can I help you?",
          "Do you need anything?"
        ],
        [
          "That's 12 dollars.",
          "the price"
        ],
        [
          "Here you are.",
          "Take this."
        ],
        [
          "Here is your change.",
          "money back"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: polite requests"
    },
    {
      "type": "rule",
      "title": "Asking politely",
      "points": [
        "Can I have …, please?",
        "Could I have …, please? (more polite)",
        "I'd like … (= I would like): I'd like a coffee, please."
      ]
    },
    {
      "type": "rule",
      "title": "this / these, it / they",
      "points": [
        "How much is this shirt? — It's 15 dollars.",
        "How much are these shoes? — They're 40 dollars."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "Give me water.",
      "right": "Can I have some water, please?",
      "why": "Sounds rude without please / can I."
    },
    {
      "type": "mistake",
      "wrong": "How much are this?",
      "right": "How much is this?"
    },
    {
      "type": "mistake",
      "wrong": "I like a coffee, please.",
      "right": "I'd like a coffee, please.",
      "why": "I like = I enjoy; I'd like = I want"
    }
  ],
