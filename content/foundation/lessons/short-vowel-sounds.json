{
  "title": "Short vowel sounds",
  "kind": "phonics",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Each vowel has a short sound."
    },
    {
      "type": "table",
      "rows": [
        [
          "a",
          "cat",
          "bag"
        ],
        [
          "e",
          "bed",
          "pen"
        ],
        [
          "i",
          "sit",
          "ship"
        ],
        [
          "o",
          "hot",
          "shop"
        ],
        [
          "u",
          "cup",
          "bus"
        ]
      ]
    },
    {
      "type": "text",
      "text": "One vowel between two consonants often has a short sound."
    },
    {
      "type": "example",
      "en": "bag — beg",
      "note": "a and e sound different"
    },
    {
      "type": "example",
      "en": "ship — shop",
      "note": "i and o sound different"
    },
    {
      "type": "tip",
      "text": "Change one vowel and you get a new word: bag, beg, big, bug."
    }
  ],
  "exercises": [
