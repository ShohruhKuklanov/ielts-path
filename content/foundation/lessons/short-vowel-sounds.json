{
  "title": "Short vowel sounds",
  "kind": "phonics",
  "cefr": "A0",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. The five short sounds"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "vowel",
          "word",
          "word"
        ],
        [
          "a",
          "cat",
          "bag"
        ],
        [
          "e",
          "bed",
          "pen"
        ],
        [
          "i",
          "sit",
          "ship"
        ],
        [
          "o",
          "hot",
          "shop"
        ],
        [
          "u",
          "cup",
          "bus"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. The spelling pattern"
    },
    {
      "type": "rule",
      "title": "Consonant + vowel + consonant",
      "points": [
        "One vowel between two consonants usually has a short sound: c-a-t, b-e-d, s-i-t.",
        "The sound is quick: say it short."
      ]
    },
    {
      "type": "example",
      "en": "bag — beg — big — bug",
      "note": "change one vowel, get a new word"
    },
    {
      "type": "example",
      "en": "ship — shop",
      "note": "i and o sound different"
    },
    {
      "type": "heading",
      "text": "3. Grammar focus: a or an?"
    },
    {
      "type": "rule",
      "title": "a / an",
      "points": [
        "Use a before a consonant sound: a cat, a bag, a pen.",
        "Use an before a vowel sound: an apple, an egg, an orange."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "a egg",
      "right": "an egg",
      "why": "egg starts with a vowel sound"
    },
    {
      "type": "mistake",
      "wrong": "I sit in a ship and buy bread.",
      "right": "I go to a shop and buy bread.",
      "why": "A ship is a boat. A shop sells things."
    }
  ],
