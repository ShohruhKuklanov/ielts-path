{
  "title": "I have, she has",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Use have with I, you, we, they."
    },
    {
      "type": "text",
      "text": "Use has with he, she, it."
    },
    {
      "type": "table",
      "rows": [
        [
          "I / you / we / they",
          "have"
        ],
        [
          "he / she / it",
          "has"
        ]
      ]
    },
    {
      "type": "example",
      "en": "I have a brother."
    },
    {
      "type": "example",
      "en": "She has two cats."
    },
    {
      "type": "text",
      "text": "Negative: don't have / doesn't have."
    },
    {
      "type": "example",
      "en": "I don't have a car."
    },
    {
      "type": "example",
      "en": "He doesn't have a sister.",
      "note": "doesn't + have (not has)"
    }
  ],
