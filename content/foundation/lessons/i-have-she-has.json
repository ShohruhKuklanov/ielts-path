{
  "title": "I have, she has",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "positive",
          "negative"
        ],
        [
          "I / you / we / they",
          "have",
          "don't have"
        ],
        [
          "he / she / it",
          "has",
          "doesn't have"
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "question",
          "short answers"
        ],
        [
          "Do you have …?",
          "Yes, I do. / No, I don't."
        ],
        [
          "Does she have …?",
          "Yes, she does. / No, she doesn't."
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "rule",
      "title": "We use have / has for",
      "points": [
        "family: I have two sisters.",
        "things you own: She has a new phone.",
        "the body: He has blue eyes.",
        "illnesses: I have a cold."
      ]
    },
    {
      "type": "heading",
      "text": "3. Rules"
    },
    {
      "type": "rule",
      "title": "After does / doesn't → have",
      "points": [
        "She doesn't have a car. (not doesn't has)",
        "Does he have a sister? (not Does he has)"
      ]
    },
    {
      "type": "rule",
      "title": "British English: have got",
      "points": [
        "In the UK people also say: I've got a brother. She's got a car."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "She have a cat.",
      "right": "She has a cat."
    },
    {
      "type": "mistake",
      "wrong": "He doesn't has a job.",
      "right": "He doesn't have a job."
    },
    {
      "type": "mistake",
      "wrong": "I have 20 years.",
      "right": "I'm 20.",
      "why": "Use be for age."
    }
  ],
