{
  "title": "Review: My family and me",
  "kind": "review",
  "cefr": "A1",
  "estMinutes": 9,
  "intro": [
    {
      "type": "heading",
      "text": "Module review"
    },
    {
      "type": "example",
      "en": "This is my mother. She is a nurse.",
      "note": "family and jobs: a + job"
    },
    {
      "type": "example",
      "en": "Her name is Dilfuza. His name is Rustam.",
      "note": "his (man) / her (woman)"
    },
    {
      "type": "example",
      "en": "My brother's car is old.",
      "note": "'s for people"
    },
    {
      "type": "example",
      "en": "My brother is tall and friendly.",
      "note": "adjectives"
    },
    {
      "type": "example",
      "en": "We have a dog. It doesn't have a name!",
      "note": "have / has"
    },
    {
      "type": "rule",
      "title": "Remember",
      "points": [
        "a / an with one job: I'm a student.",
        "his for a man, her for a woman, its for a thing.",
        "he / she / it + has; doesn't + have.",
        "Adjectives: before a noun, never plural."
      ]
    }
  ],
