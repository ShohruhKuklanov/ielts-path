{
  "title": "Don't and doesn't",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Use don't with I, you, we, they."
    },
    {
      "type": "text",
      "text": "Use doesn't with he, she, it."
    },
    {
      "type": "table",
      "rows": [
        [
          "I / you / we / they",
          "don't + verb"
        ],
        [
          "he / she / it",
          "doesn't + verb"
        ]
      ]
    },
    {
      "type": "example",
      "en": "I don't eat meat."
    },
    {
      "type": "example",
      "en": "She doesn't like coffee.",
      "note": "no -s after doesn't"
    },
    {
      "type": "tip",
      "text": "Don't = do not. Doesn't = does not."
    }
  ],
