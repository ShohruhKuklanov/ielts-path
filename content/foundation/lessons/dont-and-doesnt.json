{
  "title": "Don't and doesn't",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "negative"
        ],
        [
          "I / you / we / they",
          "don't (do not) + verb"
        ],
        [
          "he / she / it",
          "doesn't (does not) + verb"
        ]
      ]
    },
    {
      "type": "example",
      "en": "I don't eat meat."
    },
    {
      "type": "example",
      "en": "She doesn't like coffee."
    },
    {
      "type": "heading",
      "text": "2. The important rule"
    },
    {
      "type": "rule",
      "title": "After don't / doesn't: the base verb",
      "points": [
        "She doesn't like (not likes)",
        "He doesn't go (not goes)",
        "It doesn't have (not has)",
        "The -s is already in doesn't."
      ]
    },
    {
      "type": "heading",
      "text": "3. Don't mix with be"
    },
    {
      "type": "rule",
      "title": "be has its own negative",
      "points": [
        "I'm not, he isn't, they aren't — no do!",
        "She isn't tired. (not She doesn't tired)",
        "She doesn't work. (not She isn't work)"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "He don't like fish.",
      "right": "He doesn't like fish."
    },
    {
      "type": "mistake",
      "wrong": "She doesn't works here.",
      "right": "She doesn't work here."
    },
    {
      "type": "mistake",
      "wrong": "I don't am hungry.",
      "right": "I'm not hungry."
    }
  ],
