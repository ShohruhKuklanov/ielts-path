{
  "title": "He is, she is, it is",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Use he for a man or a boy."
    },
    {
      "type": "text",
      "text": "Use she for a woman or a girl."
    },
    {
      "type": "text",
      "text": "Use it for a thing or an animal."
    },
    {
      "type": "table",
      "rows": [
        [
          "he",
          "is",
          "he's"
        ],
        [
          "she",
          "is",
          "she's"
        ],
        [
          "it",
          "is",
          "it's"
        ]
      ]
    },
    {
      "type": "example",
      "en": "Bobur is my brother. He is 12."
    },
    {
      "type": "example",
      "en": "Madina is a doctor. She's from Samarkand."
    },
    {
      "type": "example",
      "en": "This is my cat. It's black."
    },
    {
      "type": "tip",
      "text": "It's = it is. Its (no ') is different: we learn it later."
    }
  ],
