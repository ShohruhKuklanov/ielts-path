    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "positive",
          "short form"
        ],
        [
          "he",
          "he is",
          "he's"
        ],
        [
          "she",
          "she is",
          "she's"
        ],
        [
          "it",
          "it is",
          "it's"
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "negative",
          "short form"
        ],
        [
          "he",
          "he is not",
          "he isn't / he's not"
        ],
        [
          "she",
          "she is not",
          "she isn't / she's not"
        ],
        [
          "it",
          "it is not",
          "it isn't / it's not"
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "question",
          "short answers"
        ],
        [
          "Is he …?",
          "Yes, he is. / No, he isn't."
        ],
        [
          "Is she …?",
          "Yes, she is. / No, she isn't."
        ],
        [
          "Is it …?",
          "Yes, it is. / No, it isn't."
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "rule",
      "title": "he / she / it",
      "points": [
        "he = a man or a boy: Bobur → he",
        "she = a woman or a girl: Madina → she",
        "it = a thing, an animal, the weather, the time: It is cold. It is 5 o'clock."
      ]
    },
    {
      "type": "example",
      "en": "Bobur is my brother. He is 12."
    },
    {
      "type": "example",
      "en": "Madina is a doctor. She's from Samarkand."
    },
    {
      "type": "example",
      "en": "This is my cat. It's black."
    },
    {
      "type": "heading",
      "text": "3. Names and nouns"
    },
    {
      "type": "rule",
      "title": "Do not repeat the subject",
      "points": [
        "Say: My mother is a nurse. (not My mother she is a nurse.)"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "My sister he is a teacher.",
      "right": "My sister is a teacher."
    },
    {
      "type": "mistake",
      "wrong": "Is cold today.",
      "right": "It is cold today.",
      "why": "English sentences need a subject: it."
    },
    {
      "type": "mistake",
      "wrong": "He's isn't here.",
      "right": "He isn't here."
    }
  ],
