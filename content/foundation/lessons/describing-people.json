          "prompt": "My grandfather is 80. He is …",
          "options": [
            {
              "text": "young"
            },
            {
              "text": "old"
            },
            {
              "text": "short"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
