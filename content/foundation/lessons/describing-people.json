{
  "title": "Describing people",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Adjectives for people"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "about the body",
          "about age",
          "about feelings / character"
        ],
        [
          "tall ↔ short",
          "young ↔ old",
          "happy ↔ sad"
        ],
        [
          "thin ↔ fat*",
          "middle-aged",
          "friendly, kind, funny"
        ],
        [
          "beautiful, handsome",
          "—",
          "tired, busy"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "*Fat can be rude. Say \"a bit big\" or don't talk about weight."
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: adjectives"
    },
    {
      "type": "rule",
      "title": "Adjective position",
      "points": [
        "After be: My brother is tall.",
        "Before a noun: a tall man, a friendly girl."
      ]
    },
    {
      "type": "rule",
      "title": "Adjectives never change",
      "points": [
        "two tall men (not talls)",
        "She is tall. They are tall."
      ]
    },
    {
      "type": "rule",
      "title": "very / quite",
      "points": [
        "very = more: He is very tall.",
        "quite = a little more than normal: She is quite young."
      ]
    },
    {
      "type": "example",
      "en": "What does she look like? — She is tall and young.",
      "note": "asking about appearance"
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "He is a man tall.",
      "right": "He is a tall man."
    },
    {
      "type": "mistake",
      "wrong": "They are talls.",
      "right": "They are tall."
    },
    {
      "type": "mistake",
      "wrong": "She is very much tall.",
      "right": "She is very tall."
    }
  ],
  "exercises": [
