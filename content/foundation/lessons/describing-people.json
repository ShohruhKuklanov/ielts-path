    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "These words are opposites.",
      "content": {
        "type": "match_pairs",
        "payload": {
          "left": [
            "tall",
            "young",
            "happy"
          ],
          "right": [
            "sad",
            "short",
            "old"
          ],
          "instruction": "Match the opposites."
        },
        "answer": {
          "pairs": [
            1,
            2,
            0
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "She smiles: friendly or happy.",
