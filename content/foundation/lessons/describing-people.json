{
  "title": "Describing people",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "table",
      "rows": [
        [
          "tall",
          "short"
        ],
        [
          "young",
          "old"
        ],
        [
          "happy",
          "tired"
        ],
        [
          "friendly"
        ]
      ]
    },
    {
      "type": "text",
      "text": "Tall and short are opposites. Young and old are opposites."
    },
    {
      "type": "example",
      "en": "My brother is tall.",
      "note": "adjective after is"
    },
    {
      "type": "example",
      "en": "She is a friendly girl.",
      "note": "adjective before the person"
    },
    {
      "type": "tip",
      "text": "Adjectives do not take -s: two tall men, not two talls men."
    }
  ],
  "exercises": [
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "At 80 a person is old.",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "My grandfather is 80. He is …",
          "options": [
            {
              "text": "young"
            },
            {
              "text": "old"
            },
            {
              "text": "short"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "Tall ↔ short.",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "The opposite of tall is …",
          "options": [
            {
              "text": "old"
            },
            {
              "text": "short"
            },
            {
              "text": "happy"
            }
          ]
        },
        "answer": {
          "correct": [
            1
