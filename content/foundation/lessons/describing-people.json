        "type": "gap_fill",
        "payload": {
          "text": "My teacher is very {{1}}. She always smiles.",
          "wordBank": [
            "friendly",
            "tired",
            "old"
          ]
        },
        "answer": {
          "blanks": {
            "1": [
              "friendly",
              "happy"
            ]
          }
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "He is + a young doctor.",
      "content": {
        "type": "word_order",
        "payload": {
          "tokens": [
            "He",
            "is",
            "young",
            "doctor",
            "a"
          ],
          "instruction": "Put the words in order."
        },
        "answer": {
          "accepted": [
            "He is a young doctor."
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
