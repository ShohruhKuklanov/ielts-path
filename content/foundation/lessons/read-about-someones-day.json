{
  "title": "Read about someone's day",
  "kind": "reading",
  "cefr": "A1",
  "estMinutes": 9,
  "intro": [
    {
      "type": "heading",
      "text": "1. How to read about a day"
    },
    {
      "type": "rule",
      "title": "Look for",
      "points": [
        "times: at 7 o'clock, in the evening",
        "actions (verbs): gets up, goes, has lunch",
        "order words: first, then, after that, finally"
      ]
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: the story of a day"
    },
    {
      "type": "rule",
      "title": "Present simple for routines",
      "points": [
        "he / she + -s: He gets up. She goes. He has.",
        "adverbs of frequency go before the main verb: She usually walks. He never drinks coffee.",
        "but after be: He is always tired."
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "100%",
          "—",
          "—",
          "—",
          "0%"
        ],
        [
          "always",
          "usually",
          "often",
          "sometimes",
          "never"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "3. Answering questions"
    },
    {
      "type": "rule",
      "title": "Find the key word",
      "points": [
        "Question: What time does Kamol start work? → look for \"start\" and a time.",
        "The answer uses the words of the text."
      ]
    }
  ],
  "exercises": [
    {
      "skill": "reading",
      "cefr": "A1",
      "explanation": "He is a bus driver and has breakfast with his wife. The number of children is not given.",
      "content": {
        "type": "tfng",
        "payload": {
          "instruction": "Read. Is it true, false, or not given?",
          "passage": "Kamol is a bus driver in Tashkent. He always gets up at 5 o'clock. He has breakfast with his wife. Then he goes to work. He starts work at 6. He usually has lunch at 12 at a small café. He comes home at 4. In the evening he plays with his children and watches TV. He never goes to bed late.",
          "statements": [
            "Kamol is a taxi driver.",
            "He gets up at 5.",
            "He has breakfast alone.",
            "He usually has lunch at a café.",
            "He has three children."
          ]
        },
        "answer": {
          "answers": [
            "false",
            "true",
            "false",
            "true",
            "not_given"
          ]
        }
      }
    },
    {
      "skill": "reading",
      "cefr": "A1",
      "explanation": "\"He starts work at 6.\"",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "What time does Kamol start work?",
          "options": [
            {
              "text": "5"
            },
            {
              "text": "6"
            },
            {
              "text": "12"
            }
          ],
          "instruction": "Read about Kamol again."
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
