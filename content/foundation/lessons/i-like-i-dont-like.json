{
  "title": "I like, I don't like",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "positive",
          "negative",
          "question"
        ],
        [
          "I / you / we / they",
          "like",
          "don't like",
          "Do you like …?"
        ],
        [
          "he / she / it",
          "likes",
          "doesn't like",
          "Does she like …?"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. like + noun / like + -ing"
    },
    {
      "type": "rule",
      "title": "Two patterns",
      "points": [
        "like + noun: I like apples. She likes music.",
        "like + verb-ing: I like reading. He likes swimming.",
        "Countable nouns are plural after like: I like cats. (not I like cat)"
      ]
    },
    {
      "type": "rule",
      "title": "Spelling of -ing",
      "points": [
        "most verbs: read → reading, play → playing",
        "e at the end: dance → dancing, write → writing",
        "short verbs (one vowel + one consonant): swim → swimming, run → running"
      ]
    },
    {
      "type": "heading",
      "text": "3. Stronger and weaker"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "😍",
          "🙂",
          "😐",
          "🙁",
          "😡"
        ],
        [
          "love",
          "like",
          "don't mind",
          "don't like",
          "hate"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I like swim.",
      "right": "I like swimming."
    },
    {
      "type": "mistake",
      "wrong": "She don't like coffee.",
      "right": "She doesn't like coffee."
    },
    {
      "type": "mistake",
      "wrong": "I like dog.",
      "right": "I like dogs."
    }
  ],
