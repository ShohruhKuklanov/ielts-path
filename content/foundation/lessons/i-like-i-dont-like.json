  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "example",
      "en": "I like apples.",
      "note": "like + thing"
    },
    {
      "type": "example",
      "en": "I love music.",
      "note": "love = like very much"
    },
    {
      "type": "example",
      "en": "I don't like coffee."
    },
    {
      "type": "text",
      "text": "After like, a verb takes -ing."
    },
    {
      "type": "example",
      "en": "I like reading.",
      "note": "read → reading"
    },
    {
      "type": "example",
      "en": "She likes swimming.",
      "note": "he/she likes"
    },
    {
      "type": "tip",
      "text": "Ask: Do you like …? — Yes, I do. / No, I don't."
    }
  ],
