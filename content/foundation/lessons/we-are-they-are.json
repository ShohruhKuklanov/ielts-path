{
  "title": "We are, they are",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "positive",
          "negative"
        ],
        [
          "we",
          "we are / we're",
          "we are not / we aren't"
        ],
        [
          "they",
          "they are / they're",
          "they are not / they aren't"
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "question",
          "short answers"
        ],
        [
          "Are we …?",
          "Yes, we are. / No, we aren't."
        ],
        [
          "Are they …?",
          "Yes, they are. / No, they aren't."
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "rule",
      "title": "we / they",
      "points": [
        "we = me + other people: My friend and I → we",
        "they = other people or things (plural): Ali and Bek → they; the books → they"
      ]
    },
    {
      "type": "example",
      "en": "We're students."
    },
    {
      "type": "example",
      "en": "Ali and Bek are brothers. They are from Namangan."
    },
    {
      "type": "example",
      "en": "The shops are closed. They aren't open on Sunday."
    },
    {
      "type": "heading",
      "text": "3. The whole verb be"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "be"
        ],
        [
          "I",
          "am"
        ],
        [
          "he / she / it",
          "is"
        ],
        [
          "you / we / they",
          "are"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Negative short forms",
      "points": [
        "is not → isn't, are not → aren't",
        "am not → 'm not (there is no amn't)"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "They is my friends.",
      "right": "They are my friends."
    },
    {
      "type": "mistake",
      "wrong": "My friend and me are students.",
      "right": "My friend and I are students."
    },
    {
      "type": "mistake",
      "wrong": "We aren't no tired.",
      "right": "We aren't tired."
    }
  ],
