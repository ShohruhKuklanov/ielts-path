{
  "title": "Places in town",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Places"
    },
    {
      "type": "table",
      "rows": [
        [
          "bank",
          "shop",
          "market"
        ],
        [
          "hospital",
          "pharmacy",
          "post office"
        ],
        [
          "school",
          "library",
          "museum"
        ],
        [
          "park",
          "station",
          "café"
        ]
      ]
    },
    {
      "type": "example",
      "en": "I buy medicine at the pharmacy."
    },
    {
      "type": "example",
      "en": "I read books in the library."
    },
    {
      "type": "heading",
      "text": "2. Asking for places"
    },
    {
      "type": "example",
      "en": "Excuse me, where's the station?",
      "note": "polite question"
    },
    {
      "type": "example",
      "en": "It's next to the park. / It's on Navoi Street.",
      "note": "answer"
    },
    {
      "type": "example",
      "en": "Is there a bank near here? — Yes, there is. It's opposite the hotel."
    },
    {
      "type": "heading",
      "text": "3. Grammar focus"
    },
    {
      "type": "rule",
      "title": "Prepositions with places",
      "points": [
        "on + street: on Navoi Street",
        "at the bank / at the station (the place where you do something)",
        "in the park / in the library (inside an area or building)"
      ]
    },
    {
      "type": "rule",
      "title": "the with places",
      "points": [
        "Use the for a place both people know: Where is the station?",
        "Use a / an for any one: Is there a pharmacy near here?"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "Where is station?",
      "right": "Where is the station?"
    },
    {
      "type": "mistake",
      "wrong": "in Navoi Street",
      "right": "on Navoi Street"
    }
  ],
