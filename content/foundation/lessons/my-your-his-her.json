{
  "title": "My, your, his, her",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "subject",
          "possessive",
          "example"
        ],
        [
          "I",
          "my",
          "my book"
        ],
        [
          "you",
          "your",
          "your phone"
        ],
        [
          "he",
          "his",
          "his car"
        ],
        [
          "she",
          "her",
          "her bag"
        ],
        [
          "it",
          "its",
          "its name"
        ],
        [
          "we",
          "our",
          "our house"
        ],
        [
          "they",
          "their",
          "their children"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "rule",
      "title": "Possessive adjectives",
      "points": [
        "They show who has something.",
        "They come before a noun: my sister, their teacher.",
        "They do not change for plural: my books (not mys books)."
      ]
    },
    {
      "type": "example",
      "en": "Aziz has a car. His car is new.",
      "note": "man → his"
    },
    {
      "type": "example",
      "en": "Lola has a bag. Her bag is red.",
      "note": "woman → her"
    },
    {
      "type": "example",
      "en": "They have a house. Their house is big."
    },
    {
      "type": "heading",
      "text": "3. Words that sound the same"
    },
    {
      "type": "rule",
      "title": "Do not mix them up",
      "points": [
        "its = belongs to it / it's = it is",
        "your = belongs to you / you're = you are",
        "their = belongs to them / they're = they are / there = in that place"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "Aziza and his brother",
      "right": "Aziza and her brother",
      "why": "Aziza is a woman → her"
    },
    {
      "type": "mistake",
      "wrong": "The dog wants it's food.",
      "right": "The dog wants its food."
    },
    {
      "type": "mistake",
      "wrong": "What's you name?",
      "right": "What's your name?"
    }
  ],
