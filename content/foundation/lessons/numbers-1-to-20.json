    {
      "type": "rule",
      "title": "Spelling",
      "points": [
        "13 to 19 end in -teen.",
        "Be careful: five → fifteen, three → thirteen, eight → eighteen (one t)."
      ]
    },
    {
      "type": "tip",
      "text": "Thirteen and thirty sound different: thir-TEEN, THIR-ty."
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: numbers and nouns"
    },
    {
      "type": "rule",
      "title": "One or more",
      "points": [
        "one + singular noun: one book, one sister.",
        "two, three … + plural noun (-s): two books, three sisters."
      ]
    },
    {
      "type": "rule",
      "title": "Your age",
      "points": [
        "Use be: I am 15. / I am 15 years old.",
        "Do not use have for age."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I have 15 years.",
      "right": "I am 15. / I'm 15 years old.",
      "why": "age = be, not have"
    },
    {
      "type": "mistake",
      "wrong": "three brother",
      "right": "three brothers",
      "why": "more than one → -s"
    },
    {
      "type": "mistake",
      "wrong": "fiveteen",
      "right": "fifteen",
      "why": "five → fif-"
    }
  ],
