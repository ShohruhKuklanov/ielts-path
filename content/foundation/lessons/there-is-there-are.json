  "intro": [
    {
      "type": "text",
      "text": "Use there is and there are to say what is in a place."
    },
    {
      "type": "table",
      "rows": [
        [
          "one thing",
          "There is (There's)"
        ],
        [
          "more things",
          "There are"
        ]
      ]
    },
    {
      "type": "example",
      "en": "There is a bed in my room."
    },
    {
      "type": "example",
      "en": "There are two windows."
    },
    {
      "type": "text",
      "text": "Negative:"
    },
    {
      "type": "example",
      "en": "There isn't a TV.",
      "note": "There aren't any chairs."
    },
    {
      "type": "tip",
      "text": "Questions: Is there a …? / Are there any …?"
    }
  ],
