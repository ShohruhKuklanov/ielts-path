  "intro": [
    {
      "type": "heading",
      "text": "1. Form: yes / no questions"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "do / does",
          "person",
          "verb"
        ],
        [
          "Do",
          "I / you / we / they",
          "work?"
        ],
        [
          "Does",
          "he / she / it",
          "work?"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Short answers"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "question",
          "yes",
          "no"
        ],
        [
          "Do you like tea?",
          "Yes, I do.",
          "No, I don't."
        ],
        [
          "Does she work here?",
          "Yes, she does.",
          "No, she doesn't."
        ],
        [
          "Do they live here?",
          "Yes, they do.",
          "No, they don't."
        ]
      ]
    },
    {
      "type": "heading",
      "text": "3. Questions with question words"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "question word",
          "do / does",
          "person",
          "verb"
        ],
        [
          "Where",
          "do",
          "you",
          "live?"
        ],
        [
          "What",
          "does",
          "she",
          "do?"
        ],
        [
          "When",
          "do",
          "they",
          "start?"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Rules",
      "points": [
        "After does, the verb has NO -s: Does he play? (not Does he plays?)",
        "Answer with do / does, not the main verb: Yes, I do. (not Yes, I like.)",
        "Questions with be have no do: Are you tired? (not Do you tired?)"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "You like coffee?",
      "right": "Do you like coffee?"
    },
    {
      "type": "mistake",
      "wrong": "Does he plays football?",
      "right": "Does he play football?"
    },
    {
      "type": "mistake",
      "wrong": "Where you live?",
      "right": "Where do you live?"
    }
  ],
