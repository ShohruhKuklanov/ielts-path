{
  "title": "Do you…? Does she…?",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "text",
      "text": "To ask a question, put do or does first."
    },
    {
      "type": "table",
      "rows": [
        [
          "Do",
          "I / you / we / they",
          "+ verb?"
        ],
        [
          "Does",
          "he / she / it",
          "+ verb?"
        ]
      ]
    },
    {
      "type": "example",
      "en": "Do you like tea?",
      "note": "Yes, I do. / No, I don't."
    },
    {
      "type": "example",
      "en": "Does she work here?",
      "note": "Yes, she does. / No, she doesn't."
    },
    {
      "type": "tip",
      "text": "After does, the verb has no -s: Does he play? Not: Does he plays?"
    }
  ],
