{
  "title": "She works: he, she, it + s",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "text",
      "text": "With he, she and it, add -s to the verb."
    },
    {
      "type": "example",
      "en": "I work → she works"
    },
    {
      "type": "example",
      "en": "I live → he lives"
    },
    {
      "type": "text",
      "text": "After o, s, sh, ch, x add -es."
    },
    {
      "type": "example",
      "en": "go → goes",
      "note": "watch → watches"
    },
    {
      "type": "text",
      "text": "Consonant + y: change y to -ies."
    },
    {
      "type": "example",
      "en": "study → studies"
    },
    {
      "type": "text",
      "text": "Have is special."
    },
    {
      "type": "example",
      "en": "have → has"
    }
  ],
