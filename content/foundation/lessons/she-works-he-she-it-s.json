{
  "title": "She works: he, she, it + s",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 9,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "verb"
        ],
        [
          "I / you / we / they",
          "work"
        ],
        [
          "he / she / it",
          "works"
        ]
      ]
    },
    {
      "type": "text",
      "text": "With he, she, it (and one person or thing: my mother, the shop) add -s."
    },
    {
      "type": "heading",
      "text": "2. Spelling rules"
    },
    {
      "type": "rule",
      "title": "Most verbs: + s",
      "points": [
        "work → works, live → lives, play → plays"
      ]
    },
    {
      "type": "rule",
      "title": "-o, -s, -sh, -ch, -x: + es",
      "points": [
        "go → goes, do → does, kiss → kisses, wash → washes, watch → watches, fix → fixes"
      ]
    },
    {
      "type": "rule",
      "title": "consonant + y: y → ies",
      "points": [
        "study → studies, fly → flies, carry → carries"
      ]
    },
    {
      "type": "rule",
      "title": "vowel + y: + s",
      "points": [
        "play → plays, buy → buys"
      ]
    },
    {
      "type": "rule",
      "title": "have is irregular",
      "points": [
        "have → has"
      ]
    },
    {
      "type": "heading",
      "text": "3. Pronunciation of -s"
    },
    {
      "type": "rule",
      "title": "Three sounds",
      "points": [
        "/s/: works, likes",
        "/z/: plays, lives",
        "/ɪz/: watches, washes, fixes (an extra syllable)"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "She work in a shop.",
      "right": "She works in a shop."
    },
    {
      "type": "mistake",
      "wrong": "He studys English.",
      "right": "He studies English."
    },
    {
      "type": "mistake",
      "wrong": "My father haves a car.",
      "right": "My father has a car."
    }
  ],
