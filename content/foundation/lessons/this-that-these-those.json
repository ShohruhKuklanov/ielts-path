{
  "title": "This, that, these, those",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "how many?",
          "near (here)",
          "far (there)"
        ],
        [
          "one",
          "this",
          "that"
        ],
        [
          "more than one",
          "these",
          "those"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "example",
      "en": "This is my bag.",
      "note": "one, near"
    },
    {
      "type": "example",
      "en": "These are my books.",
      "note": "more, near"
    },
    {
      "type": "example",
      "en": "That is a bus.",
      "note": "one, far"
    },
    {
      "type": "example",
      "en": "Those are my friends.",
      "note": "more, far"
    },
    {
      "type": "rule",
      "title": "With a noun or alone",
      "points": [
        "With a noun: this phone, those shoes.",
        "Alone: This is nice. What is that?"
      ]
    },
    {
      "type": "rule",
      "title": "Verb",
      "points": [
        "this / that + is",
        "these / those + are"
      ]
    },
    {
      "type": "rule",
      "title": "Introducing people",
      "points": [
        "On the phone and when you introduce someone, use this: This is my brother, Ali."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "This are my keys.",
      "right": "These are my keys."
    },
    {
      "type": "mistake",
      "wrong": "Those book is old.",
      "right": "That book is old. / Those books are old."
    },
    {
      "type": "mistake",
      "wrong": "These is my sister.",
      "right": "This is my sister."
    }
  ],
