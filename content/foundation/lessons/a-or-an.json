{
  "title": "A or an?",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "a",
          "an"
        ],
        [
          "before a consonant SOUND",
          "before a vowel SOUND"
        ],
        [
          "a book, a pen, a car",
          "an apple, an egg, an umbrella"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "rule",
      "title": "We use a / an",
      "points": [
        "with ONE thing or person (singular): a bag, an orange.",
        "to say what something is: It is a pen.",
        "with jobs: She is a doctor. He is an engineer."
      ]
    },
    {
      "type": "rule",
      "title": "We do NOT use a / an",
      "points": [
        "with plurals: books (not a books)",
        "with uncountable things: water, rice, milk (not a water)",
        "with names: Aziz (not an Aziz)"
      ]
    },
    {
      "type": "heading",
      "text": "3. Sound, not letter"
    },
    {
      "type": "rule",
      "title": "Listen to the first SOUND",
      "points": [
        "an hour — h is silent, the sound is \"ow\".",
        "a university, a uniform — the sound is \"you\" (a consonant sound).",
        "an umbrella — u sounds like \"uh\" (a vowel sound)."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "a apple",
      "right": "an apple"
    },
    {
      "type": "mistake",
      "wrong": "He is engineer.",
      "right": "He is an engineer.",
      "why": "Use a / an with jobs."
    },
    {
      "type": "mistake",
      "wrong": "I have a books.",
      "right": "I have books. / I have a book."
    },
    {
      "type": "mistake",
      "wrong": "an university",
      "right": "a university",
      "why": "university starts with a \"you\" sound"
    }
  ],
