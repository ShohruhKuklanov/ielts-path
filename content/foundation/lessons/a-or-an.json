{
  "title": "A or an?",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "We use a or an before one thing."
    },
    {
      "type": "text",
      "text": "Use an before the sounds a, e, i, o, u."
    },
    {
      "type": "example",
      "en": "a book",
      "note": "b → a"
    },
    {
      "type": "example",
      "en": "an apple",
      "note": "a → an"
    },
    {
      "type": "table",
      "rows": [
        [
          "a",
          "an"
        ],
        [
          "a pen",
          "an egg"
        ],
        [
          "a bag",
          "an orange"
        ],
        [
          "a car",
          "an umbrella"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Listen to the first sound. Hour starts with an o sound, so we say an hour."
    }
  ],
