{
  "title": "Hello and goodbye",
  "kind": "vocabulary",
  "cefr": "A0",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Saying hello"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "when?",
          "we say"
        ],
        [
          "any time",
          "Hello! / Hi!"
        ],
        [
          "before 12:00",
          "Good morning!"
        ],
        [
          "12:00 – 18:00",
          "Good afternoon!"
        ],
        [
          "after 18:00",
          "Good evening!"
        ]
      ]
    },
    {
      "type": "text",
      "text": "Hi is friendly: use it with friends and family."
    },
    {
      "type": "heading",
      "text": "2. Meeting someone new"
    },
    {
      "type": "example",
      "en": "A: Hello, I'm Aziz. Nice to meet you."
    },
    {
      "type": "example",
      "en": "B: Nice to meet you, too.",
      "note": "answer with too"
    },
    {
      "type": "example",
      "en": "How are you? — I'm fine, thanks. And you?"
    },
    {
      "type": "heading",
      "text": "3. Saying goodbye"
    },
    {
      "type": "rule",
      "title": "Goodbye",
      "points": [
        "Goodbye! / Bye! / See you!",
        "Good night! = only when you go to bed or leave at night."
      ]
    },
    {
      "type": "heading",
      "text": "4. Grammar focus: I'm and you're"
    },
    {
      "type": "rule",
      "title": "Short forms",
      "points": [
        "I am → I'm: I'm fine.",
        "you are → you're",
        "We use short forms when we speak."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "Good night! (when you meet someone)",
      "right": "Good evening!",
      "why": "Good night is for goodbye, not hello."
    },
    {
      "type": "mistake",
      "wrong": "Nice to meet you, also.",
      "right": "Nice to meet you, too."
    },
    {
      "type": "mistake",
      "wrong": "I fine.",
      "right": "I'm fine.",
      "why": "Do not forget am."
    }
  ],
