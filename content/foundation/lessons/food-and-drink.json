          "rice, bread, meat"
        ],
        [
          "a banana, five bananas",
          "cheese, sugar, salt"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Uncountable nouns",
      "points": [
        "No a / an: water (not a water)",
        "No plural -s: rice (not rices)",
        "Use a container to count them: a glass of water, a cup of tea, a bottle of juice, a piece of bread"
      ]
    },
    {
      "type": "rule",
      "title": "Meals",
      "points": [
        "for breakfast / for lunch / for dinner: I eat eggs for breakfast."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "a bread",
      "right": "some bread / a piece of bread"
    },
