{
  "title": "Capital letters and full stops",
  "kind": "writing",
  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "A sentence starts with a capital (big) letter."
    },
    {
      "type": "text",
      "text": "A sentence ends with a full stop (.) or a question mark (?)."
    },
    {
      "type": "example",
      "en": "My name is Jasur."
    },
    {
      "type": "example",
      "en": "Where are you from?"
    },
    {
      "type": "text",
      "text": "Always use capital letters for:"
    },
    {
      "type": "table",
      "rows": [
        [
          "I",
          "I am happy."
        ],
        [
          "names",
          "Aziz, Maria"
        ],
        [
          "countries and cities",
          "Uzbekistan, Bukhara"
        ],
        [
          "days and months",
          "Monday, May"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Languages and nationalities too: English, Uzbek."
    }
  ],
  "exercises": [
