{
  "title": "Capital letters and full stops",
  "kind": "writing",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Sentences"
    },
    {
      "type": "rule",
      "title": "Every sentence",
      "points": [
        "starts with a capital letter: My …",
        "ends with a full stop (.), a question mark (?) or an exclamation mark (!)"
      ]
    },
    {
      "type": "example",
      "en": "My name is Jasur."
    },
    {
      "type": "example",
      "en": "Where are you from?"
    },
    {
      "type": "example",
      "en": "What a beautiful day!"
    },
    {
      "type": "heading",
      "text": "2. Capital letters for names"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "use a capital for",
          "examples"
        ],
        [
          "I",
          "I am happy."
        ],
        [
          "people",
          "Aziz, Maria"
        ],
        [
          "countries and cities",
          "Uzbekistan, Bukhara"
        ],
        [
          "nationalities and languages",
          "Uzbek, English"
        ],
        [
          "days and months",
          "Monday, May"
        ],
        [
          "streets and places",
          "Navoi Street, Chorsu Bazaar"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "No capital for",
      "points": [
        "seasons: summer, winter",
        "jobs and school subjects (usually): teacher, maths"
      ]
    },
    {
      "type": "heading",
      "text": "3. Commas"
    },
    {
      "type": "rule",
      "title": "The comma (,)",
      "points": [
        "in lists: I speak Uzbek, Russian and English. (no comma before and)",
        "after Hello / Hi in messages: Hi Kamila,"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "i live in tashkent",
      "right": "I live in Tashkent."
    },
    {
      "type": "mistake",
      "wrong": "My birthday is in Summer.",
      "right": "My birthday is in summer."
    },
    {
      "type": "mistake",
      "wrong": "Where do you work.",
      "right": "Where do you work?"
    }
  ],
