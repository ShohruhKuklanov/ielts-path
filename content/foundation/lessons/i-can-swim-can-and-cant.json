{
  "title": "I can swim: can and can't",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Use can to say you are able to do something."
    },
    {
      "type": "example",
      "en": "I can swim."
    },
    {
      "type": "example",
      "en": "She can't drive.",
      "note": "can't = cannot"
    },
    {
      "type": "text",
      "text": "Can is the same for everyone. The verb has no -s."
    },
    {
      "type": "example",
      "en": "He can cook.",
      "note": "not: He can cooks. Not: He cans cook."
    },
    {
      "type": "example",
      "en": "Can you speak English? — Yes, I can. / No, I can't."
    }
  ],
