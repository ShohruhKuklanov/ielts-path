{
  "title": "Is it? Are you? Questions with be",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "To make a question, put am, is or are first."
    },
    {
      "type": "example",
      "en": "You are a student. → Are you a student?"
    },
    {
      "type": "example",
      "en": "It is a cat. → Is it a cat?"
    },
    {
      "type": "text",
      "text": "Short answers:"
    },
    {
      "type": "table",
      "rows": [
        [
          "Are you …?",
          "Yes, I am.",
          "No, I'm not."
        ],
        [
          "Is it …?",
          "Yes, it is.",
          "No, it isn't."
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Don't say \"Yes, I'm.\" Say \"Yes, I am.\""
    }
  ],
  "exercises": [
