{
  "title": "I work, you work: present simple",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "Use the present simple for things you do often."
    },
    {
      "type": "example",
      "en": "I work in a bank."
    },
    {
      "type": "example",
      "en": "We live in Tashkent."
    },
    {
      "type": "example",
      "en": "They study English every day."
    },
    {
      "type": "table",
      "rows": [
        [
          "I / you / we / they",
          "work, live, study, play"
        ]
      ]
    },
    {
      "type": "text",
      "text": "Time words: every day, every week, in the morning, at night."
    },
    {
      "type": "tip",
      "text": "Time words often go at the end: I drink tea every morning."
    }
  ],
