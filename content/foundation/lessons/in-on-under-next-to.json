{
  "title": "In, on, under, next to",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Prepositions of place"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "preposition",
          "example"
        ],
        [
          "in (inside)",
          "The keys are in the bag."
        ],
        [
          "on (on top of, touching)",
          "The book is on the table. The picture is on the wall."
        ],
        [
          "under (below)",
          "The cat is under the bed."
        ],
        [
          "next to (at the side)",
          "The lamp is next to the bed."
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "preposition",
          "example"
        ],
        [
          "behind",
          "The garden is behind the house."
        ],
        [
          "in front of",
          "The car is in front of the house."
        ],
        [
          "between (two things)",
          "The bank is between the shop and the café."
        ],
        [
          "opposite (across from)",
          "The school is opposite the park."
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Grammar rules"
    },
    {
      "type": "rule",
      "title": "Word order",
      "points": [
        "thing + be + preposition + place: The phone is on the sofa.",
        "Where is …? — It is in / on / under …"
      ]
    },
    {
      "type": "rule",
      "title": "Fixed phrases",
      "points": [
        "in a city / in a country: in Tashkent, in Japan",
        "on the floor, on the wall, on the left / right",
        "at home, at school, at work"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "The picture is in the wall.",
      "right": "The picture is on the wall."
    },
    {
      "type": "mistake",
      "wrong": "next the bed",
      "right": "next to the bed"
    },
    {
      "type": "mistake",
      "wrong": "between the bank",
      "right": "between the bank and the café",
      "why": "between needs two things"
    }
  ],
