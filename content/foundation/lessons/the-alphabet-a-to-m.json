        "payload": {
          "left": [
            "A",
            "B",
            "D",
            "E"
          ],
          "right": [
            "a",
            "e",
            "b",
            "d"
          ],
          "instruction": "Match the big and small letters."
        },
        "answer": {
          "pairs": [
