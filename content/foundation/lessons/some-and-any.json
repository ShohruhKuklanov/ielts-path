{
  "title": "Some and any",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 9,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "sentence",
          "countable plural",
          "uncountable"
        ],
        [
          "positive",
          "There are some apples.",
          "There is some milk."
        ],
        [
          "negative",
          "There aren't any apples.",
          "There isn't any milk."
        ],
        [
          "question",
          "Are there any apples?",
          "Is there any milk?"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "2. Rules"
    },
    {
      "type": "rule",
      "title": "some",
      "points": [
        "in positive sentences",
        "with plural nouns (some eggs) and uncountable nouns (some water)",
        "meaning: a number or amount, but we don't say exactly how much"
      ]
    },
    {
      "type": "rule",
      "title": "any",
      "points": [
        "in negative sentences and questions",
        "We don't have any bread. Do you have any brothers?"
      ]
    },
    {
      "type": "rule",
      "title": "a / an",
      "points": [
        "with ONE countable thing: an apple, a sandwich (not some apple)"
      ]
    },
    {
      "type": "heading",
      "text": "3. Offers and requests"
    },
    {
      "type": "rule",
      "title": "some in questions",
      "points": [
        "When we offer or ask for something, we use some: Would you like some tea? Can I have some water?"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I don't have some money.",
      "right": "I don't have any money."
    },
    {
      "type": "mistake",
      "wrong": "There is any milk.",
      "right": "There is some milk."
    },
    {
      "type": "mistake",
      "wrong": "Can I have any coffee, please?",
      "right": "Can I have some coffee, please?",
      "why": "requests use some"
    }
  ],
