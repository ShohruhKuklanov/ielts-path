  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "text",
      "text": "We can count some nouns: an apple, two apples."
    },
    {
      "type": "text",
      "text": "We cannot count some nouns: water, rice, milk."
    },
    {
      "type": "table",
      "rows": [
        [
          "positive",
          "some"
        ],
        [
          "negative",
          "any"
        ],
        [
          "question",
          "any"
        ]
      ]
    },
    {
      "type": "example",
      "en": "There are some apples."
    },
    {
      "type": "example",
      "en": "There is some water."
    },
    {
      "type": "example",
      "en": "We don't have any bread."
    },
    {
      "type": "example",
      "en": "Are there any eggs?"
    },
    {
      "type": "tip",
      "text": "Do not say \"a water\". Say \"some water\" or \"a glass of water\"."
    }
  ],
