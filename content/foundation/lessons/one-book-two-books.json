{
  "title": "One book, two books",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "For more than one thing, we usually add -s."
    },
    {
      "type": "example",
      "en": "one book → two books"
    },
    {
      "type": "example",
      "en": "one pen → three pens"
    },
    {
      "type": "text",
      "text": "After s, x, sh, ch we add -es."
    },
    {
      "type": "example",
      "en": "one bus → two buses",
      "note": "one box → two boxes"
    },
    {
      "type": "text",
      "text": "Some words change completely."
    },
    {
      "type": "table",
      "rows": [
        [
          "man",
          "men"
        ],
        [
          "woman",
          "women"
        ],
        [
          "child",
          "children"
        ],
        [
          "person",
          "people"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Say one person, two people. Not: two persons."
    }
  ],
