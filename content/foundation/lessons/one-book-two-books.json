{
  "title": "One book, two books",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Regular plurals"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "rule",
          "examples"
        ],
        [
          "most nouns + -s",
          "book → books, pen → pens"
        ],
        [
          "-s, -ss, -sh, -ch, -x + -es",
          "bus → buses, class → classes, dish → dishes, watch → watches, box → boxes"
        ],
        [
          "consonant + y → -ies",
          "city → cities, baby → babies"
        ],
        [
          "vowel + y → + s",
          "day → days, boy → boys"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "More spelling",
      "points": [
        "Some words in -f / -fe → -ves: knife → knives, wife → wives",
        "Some words in -o + -es: potato → potatoes, tomato → tomatoes"
      ]
    },
    {
      "type": "heading",
      "text": "2. Irregular plurals"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "one",
          "more"
        ],
        [
          "man",
          "men"
        ],
        [
          "woman",
          "women"
        ],
        [
          "child",
          "children"
        ],
        [
          "person",
          "people"
        ],
        [
          "foot",
          "feet"
        ],
        [
          "tooth",
          "teeth"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "3. Use"
    },
    {
      "type": "rule",
      "title": "Singular and plural",
      "points": [
        "one + singular: one book",
        "two, three, many … + plural: three books, many people",
        "With plurals use are: The books are new."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "two persons",
      "right": "two people"
    },
    {
      "type": "mistake",
      "wrong": "three childrens",
      "right": "three children",
      "why": "children is already plural"
    },
    {
      "type": "mistake",
      "wrong": "The buses is red.",
      "right": "The buses are red."
    }
  ],
