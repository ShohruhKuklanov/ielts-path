{
  "title": "I am, you are",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 8,
  "intro": [
    {
      "type": "heading",
      "text": "1. Form"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "—",
          "long form",
          "short form"
        ],
        [
          "I",
          "I am",
          "I'm"
        ],
        [
          "you",
          "you are",
          "you're"
        ]
      ]
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "—",
          "negative",
          "short form"
        ],
        [
          "I",
          "I am not",
          "I'm not"
        ],
        [
          "you",
          "you are not",
          "you aren't / you're not"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Short forms",
      "points": [
        "We use short forms in speaking and in friendly writing.",
        "The ' (apostrophe) shows a missing letter: I am → I'm."
      ]
    },
    {
      "type": "heading",
      "text": "2. Use"
    },
    {
      "type": "text",
      "text": "We use am / are to say who we are, where we are from, our age, our job and how we feel."
    },
    {
      "type": "example",
      "en": "I am Aziz.",
      "note": "name"
    },
    {
      "type": "example",
      "en": "I'm from Uzbekistan.",
      "note": "country"
    },
    {
      "type": "example",
      "en": "You're 16.",
      "note": "age"
    },
    {
      "type": "example",
      "en": "I'm a student.",
      "note": "job"
    },
    {
      "type": "example",
      "en": "You're tired.",
      "note": "feeling"
    },
    {
      "type": "heading",
      "text": "3. Spelling"
    },
    {
      "type": "rule",
      "title": "Capital I",
      "points": [
        "I is always a capital letter: I am happy. (not i am happy)"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I student.",
      "right": "I'm a student.",
      "why": "Do not forget am."
    },
    {
      "type": "mistake",
      "wrong": "You is my friend.",
      "right": "You are my friend.",
      "why": "you + are"
    },
    {
      "type": "mistake",
      "wrong": "I am have 15 years.",
      "right": "I'm 15.",
      "why": "Age = be + number."
    },
    {
      "type": "mistake",
      "wrong": "I amn't tired.",
      "right": "I'm not tired."
    }
  ],
  "exercises": [
