{
  "title": "I am, you are",
  "kind": "grammar",
  "cefr": "A0",
  "estMinutes": 6,
  "intro": [
    {
      "type": "text",
      "text": "We use am with I."
    },
    {
      "type": "text",
      "text": "We use are with you."
    },
    {
      "type": "table",
      "rows": [
        [
          "I",
          "am",
          "I'm"
        ],
        [
          "you",
          "are",
          "you're"
        ]
      ]
    },
    {
      "type": "example",
      "en": "I am Aziz.",
      "note": "I + am"
    },
    {
      "type": "example",
      "en": "You are a student.",
      "note": "you + are"
    },
    {
      "type": "example",
      "en": "I'm from Uzbekistan.",
      "note": "I'm = I am"
    },
    {
      "type": "example",
      "en": "I'm not from Japan.",
      "note": "I am not = I'm not"
    },
    {
      "type": "tip",
      "text": "Always write I with a big letter: I, not i."
    }
  ],
