    {
      "type": "rule",
      "title": "Remember",
      "points": [
        "I am / you are — never \"I is\" or \"you is\".",
        "Questions: Are you …? Is it …?",
        "Short answers: Yes, I am. No, I'm not.",
        "Numbers: twenty-five (hyphen), forty (no u)."
      ]
    }
