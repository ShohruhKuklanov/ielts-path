{
  "title": "Jobs",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Jobs"
    },
    {
      "type": "table",
      "rows": [
        [
          "teacher",
          "doctor",
          "nurse"
        ],
        [
          "student",
          "driver",
          "engineer"
        ],
        [
          "cook",
          "farmer",
          "police officer"
        ],
        [
          "shop assistant",
          "pilot",
          "builder"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Jobs with -er / -or",
      "points": [
        "teach → teacher, drive → driver, build → builder, act → actor"
      ]
    },
    {
      "type": "heading",
      "text": "2. Talking about jobs"
    },
    {
      "type": "example",
      "en": "What do you do?",
      "note": "This question asks about your job."
    },
    {
      "type": "example",
      "en": "I'm a nurse. I work in a hospital."
    },
    {
      "type": "example",
      "en": "What does she do? — She is an engineer."
    },
    {
      "type": "heading",
      "text": "3. Grammar focus: a / an with jobs"
    },
    {
      "type": "rule",
      "title": "a / an + job",
      "points": [
        "Always use a / an with one person's job: She is a doctor.",
        "an before a vowel sound: an engineer, an artist.",
        "Plural: no a / an: They are doctors."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I'm student.",
      "right": "I'm a student."
    },
    {
      "type": "mistake",
      "wrong": "She is a engineer.",
      "right": "She is an engineer."
    },
    {
      "type": "mistake",
      "wrong": "They are a teachers.",
      "right": "They are teachers."
    }
  ],
