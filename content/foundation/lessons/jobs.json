    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "People work in different places.",
      "content": {
        "type": "match_pairs",
        "payload": {
          "left": [
            "driver",
            "farmer",
            "shop assistant",
            "doctor"
          ],
          "right": [
            "a shop",
            "a bus",
            "a hospital",
            "a field"
          ],
          "instruction": "Match the job and the place."
        },
        "answer": {
          "pairs": [
            1,
            3,
            0,
            2
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "A teacher teaches.",
      "content": {
        "type": "gap_fill",
        "payload": {
          "text": "A: What do you do? B: I'm a {{1}}. I teach English."
        },
        "answer": {
          "blanks": {
            "1": [
              "teacher"
            ]
          }
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "My father + is + a police officer.",
      "content": {
        "type": "word_order",
        "payload": {
          "tokens": [
            "father",
            "My",
            "a",
            "is",
            "police",
            "officer"
          ],
          "instruction": "Put the words in order."
        },
        "answer": {
          "accepted": [
            "My father is a police officer."
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "What + do + you + do?",
      "content": {
        "type": "word_order",
        "payload": {
          "tokens": [
            "do",
            "do",
            "you",
            "What"
          ],
          "instruction": "Put the words in order."
        },
        "answer": {
          "accepted": [
