    },
    {
      "type": "example",
      "en": "She is a doctor."
    },
    {
      "type": "example",
      "en": "I'm an engineer.",
      "note": "an before a vowel sound"
    },
    {
      "type": "example",
      "en": "What do you do?",
      "note": "This question asks about your job."
    },
    {
      "type": "tip",
      "text": "Say \"I'm a student\", not \"I'm student\"."
    }
  ],
  "exercises": [
