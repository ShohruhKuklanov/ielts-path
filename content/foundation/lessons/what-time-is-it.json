{
  "title": "What time is it?",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Asking the time"
    },
    {
      "type": "example",
      "en": "What time is it? / What's the time?"
    },
    {
      "type": "example",
      "en": "It's three o'clock.",
      "note": "3:00 — o'clock only for full hours"
    },
    {
      "type": "heading",
      "text": "2. Past and to"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "time",
          "we say"
        ],
        [
          "3:15",
          "quarter past three"
        ],
        [
          "3:30",
          "half past three"
        ],
        [
          "3:45",
          "quarter to four"
        ],
        [
          "3:10",
          "ten past three"
        ],
        [
          "3:50",
          "ten to four"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "past or to?",
      "points": [
        "Minutes 1–30: past the hour (ten past three).",
        "Minutes 31–59: to the NEXT hour (ten to four)."
      ]
    },
    {
      "type": "rule",
      "title": "Digital way (also correct)",
      "points": [
        "3:15 = three fifteen, 3:45 = three forty-five",
        "9:05 = nine oh five"
      ]
    },
    {
      "type": "heading",
      "text": "3. Grammar focus: at + time"
    },
    {
      "type": "rule",
      "title": "Prepositions of time",
      "points": [
        "at + clock time: at 7 o'clock, at half past six",
        "in + parts of the day: in the morning, in the afternoon, in the evening",
        "at night"
      ]
    },
    {
      "type": "rule",
      "title": "a.m. / p.m.",
      "points": [
        "a.m. = before 12 noon, p.m. = after 12 noon: 8 a.m., 8 p.m."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "It's three o'clock and a half.",
      "right": "It's half past three."
    },
    {
      "type": "mistake",
      "wrong": "in 7 o'clock",
      "right": "at 7 o'clock"
    },
    {
      "type": "mistake",
      "wrong": "in the night",
      "right": "at night"
    }
  ],
