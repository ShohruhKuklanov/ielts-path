      "note": "3:15"
    },
    {
      "type": "example",
      "en": "It's quarter to four.",
      "note": "3:45"
    },
    {
      "type": "text",
      "text": "Past = after the hour. To = before the next hour."
    },
    {
      "type": "tip",
      "text": "You can also say the numbers: 3:15 = three fifteen."
    }
