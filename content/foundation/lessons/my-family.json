{
  "title": "My family",
  "kind": "vocabulary",
  "cefr": "A0",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Family words"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "woman / girl",
          "man / boy",
          "both"
        ],
        [
          "mother (mum)",
          "father (dad)",
          "parents"
        ],
        [
          "sister",
          "brother",
          "brothers and sisters"
        ],
        [
          "daughter",
          "son",
          "children"
        ],
        [
          "grandmother",
          "grandfather",
          "grandparents"
        ],
        [
          "wife",
          "husband",
          "—"
        ]
      ]
    },
    {
      "type": "example",
      "en": "This is my mother.",
      "note": "Use this is to show someone."
    },
    {
      "type": "example",
      "en": "I have one brother and two sisters."
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: 's for family"
    },
    {
      "type": "rule",
      "title": "Name + 's",
      "points": [
        "Aziz's sister = the sister of Aziz.",
        "My mother's name is Dilfuza.",
        "Plural nouns: my parents' house (only ')."
      ]
    },
    {
      "type": "rule",
      "title": "have got / have",
      "points": [
        "I have two brothers. She has a son."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "the sister of Aziz",
      "right": "Aziz's sister",
      "why": "For people we use 's."
    },
    {
      "type": "mistake",
      "wrong": "I have two sister.",
      "right": "I have two sisters."
    },
    {
      "type": "mistake",
      "wrong": "My mother name is Lola.",
      "right": "My mother's name is Lola."
    }
  ],
