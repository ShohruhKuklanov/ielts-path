{
  "title": "Write about yourself",
  "kind": "writing",
  "cefr": "A1",
  "estMinutes": 9,
  "intro": [
    {
      "type": "heading",
      "text": "1. What to write"
    },
    {
      "type": "rule",
      "title": "A short text about you (5–6 sentences)",
      "points": [
        "1. name and age",
        "2. where you are from and where you live",
        "3. family",
        "4. job or studies",
        "5. likes and hobbies"
      ]
    },
    {
      "type": "example",
      "en": "My name is Otabek and I am 17."
    },
    {
      "type": "example",
      "en": "I am from Fergana, but I live in Tashkent."
    },
    {
      "type": "example",
      "en": "I am a student. I like football and music."
    },
    {
      "type": "heading",
      "text": "2. Grammar focus: joining ideas"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "word",
          "use",
          "example"
        ],
        [
          "and",
          "adds a similar idea",
          "I am a student and I love music."
        ],
        [
          "but",
          "shows a difference",
          "I like English but it is difficult."
        ],
        [
          "because",
          "gives a reason",
          "I study English because I want to go abroad."
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Also / too",
      "points": [
        "also goes before the main verb: I also like tennis.",
        "too goes at the end: I like tennis, too."
      ]
    },
    {
      "type": "heading",
      "text": "3. Check your writing"
    },
    {
      "type": "rule",
      "title": "Checklist",
      "points": [
        "capital letters and full stops in every sentence",
        "he / she + -s: My brother works …",
        "a / an with jobs: I am a student.",
        "and / but / because to join short sentences"
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "I like football, I like music.",
      "right": "I like football and music."
    },
    {
      "type": "mistake",
      "wrong": "I am student.",
      "right": "I am a student."
    },
    {
      "type": "mistake",
      "wrong": "I too like tennis.",
      "right": "I also like tennis. / I like tennis, too."
    }
  ],
  "exercises": [
