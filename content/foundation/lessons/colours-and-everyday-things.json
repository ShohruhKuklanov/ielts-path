        ]
      ]
    },
    {
      "type": "text",
      "text": "Light blue and dark blue: light = more white, dark = more black."
    },
    {
      "type": "heading",
      "text": "2. Everyday things"
    },
    {
      "type": "table",
      "rows": [
        [
          "a bag",
          "a phone",
          "a pen"
        ],
        [
          "a key",
          "a book",
          "a cup"
        ],
        [
          "a chair",
          "a table",
          "a watch"
        ]
      ]
    },
    {
      "type": "heading",
      "text": "3. Grammar focus: adjectives"
    },
    {
      "type": "rule",
      "title": "Where does the colour go?",
      "points": [
        "Before the noun: a red bag (not a bag red).",
        "After be: The bag is red."
      ]
    },
    {
      "type": "rule",
      "title": "Adjectives do not change",
      "points": [
        "two red bags (not two reds bags)",
        "The cars are black. (not blacks)"
      ]
    },
    {
      "type": "example",
      "en": "What colour is it? — It's green.",
      "note": "asking about colour"
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "a bag red",
      "right": "a red bag"
    },
    {
      "type": "mistake",
      "wrong": "two blacks pens",
      "right": "two black pens"
    },
    {
      "type": "mistake",
      "wrong": "What colour it is?",
      "right": "What colour is it?"
    }
  ],
