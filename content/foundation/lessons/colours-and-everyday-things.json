        "type": "mcq",
        "payload": {
          "prompt": "Which is correct?",
          "options": [
            {
              "text": "a bag red"
            },
            {
              "text": "a red bag"
            },
            {
              "text": "a reds bag"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A0",
      "explanation": "Colours do not take -s: two black pens.",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "Which is correct?",
          "options": [
            {
              "text": "two blacks pens"
            },
            {
              "text": "two black pens"
            },
            {
              "text": "two pens black"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A0",
      "explanation": "Snow is white. Coffee is brown.",
      "content": {
        "type": "match_pairs",
        "payload": {
          "left": [
            "snow",
            "an orange",
            "coffee",
            "a tomato"
          ],
          "right": [
            "brown",
            "white",
            "orange",
            "red"
          ],
          "instruction": "Match the thing and its colour."
        },
        "answer": {
          "pairs": [
            1,
            2,
            0,
            3
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A0",
      "explanation": "Milk is white.",
      "content": {
        "type": "gap_fill",
        "payload": {
          "text": "Milk is {{1}}."
        },
        "answer": {
          "blanks": {
            "1": [
              "white"
            ]
          }
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A0",
      "explanation": "I have + a green bag.",
      "content": {
        "type": "word_order",
        "payload": {
          "tokens": [
            "a",
            "green",
            "I",
            "bag",
            "have"
          ],
          "instruction": "Put the words in order."
        },
        "answer": {
          "accepted": [
            "I have a green bag."
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A0",
      "explanation": "My phone + is + grey.",
      "content": {
        "type": "word_order",
        "payload": {
          "tokens": [
            "is",
            "My",
            "grey",
            "phone"
          ],
          "instruction": "Put the words in order."
        },
        "answer": {
          "accepted": [
            "My phone is grey."
          ]
        }
      }
    }
  ]
