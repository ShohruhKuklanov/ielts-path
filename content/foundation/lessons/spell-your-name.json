{
  "title": "Spell your name",
  "kind": "alphabet",
  "cefr": "A0",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Asking and answering"
    },
    {
      "type": "example",
      "en": "What's your name?",
      "note": "What's = What is"
    },
    {
      "type": "example",
      "en": "My name is Laylo. / I'm Laylo."
    },
    {
      "type": "example",
      "en": "How do you spell that?",
      "note": "Ask for the letters."
    },
    {
      "type": "example",
      "en": "L - A - Y - L - O.",
      "note": "Say the letters one by one."
    },
    {
      "type": "heading",
      "text": "2. Spelling rules"
    },
    {
      "type": "rule",
      "title": "Saying the letters",
      "points": [
        "Say each letter clearly: B - E - N.",
        "Two letters the same together: say \"double\": A - double N - A (Anna).",
        "Names always start with a capital letter."
      ]
    },
    {
      "type": "heading",
      "text": "3. Grammar focus: my and your"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "person",
          "word",
          "example"
        ],
        [
          "I",
          "my",
          "My name is Aziz."
        ],
        [
          "you",
          "your",
          "What is your name?"
        ]
      ]
    },
    {
      "type": "text",
      "text": "We ask with your. We answer with my."
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "What's you name?",
      "right": "What's your name?",
      "why": "you → your"
    },
    {
      "type": "mistake",
      "wrong": "I name is Timur.",
      "right": "My name is Timur.",
      "why": "I → my"
    },
    {
      "type": "mistake",
      "wrong": "How you spell that?",
      "right": "How do you spell that?",
      "why": "Questions with spell need do."
    }
  ],
