{
  "title": "Spell your name",
  "kind": "alphabet",
  "cefr": "A0",
  "estMinutes": 5,
  "intro": [
    {
      "type": "text",
      "text": "To spell a word, say each letter."
    },
    {
      "type": "example",
      "en": "Aziz: A - Z - I - Z"
    },
    {
      "type": "example",
      "en": "What's your name?",
      "note": "a question"
    },
    {
      "type": "example",
      "en": "My name is Laylo.",
      "note": "the answer"
    },
    {
      "type": "example",
      "en": "How do you spell that?",
      "note": "Ask for the letters."
    },
    {
      "type": "example",
      "en": "L - A - Y - L - O.",
      "note": "Say the letters one by one."
    },
    {
      "type": "tip",
      "text": "Two letters the same? You can say \"double\": A - double N - A."
    }
  ],
  "exercises": [
