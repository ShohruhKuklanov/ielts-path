{
  "title": "Numbers 20 to 100",
  "kind": "vocabulary",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "heading",
      "text": "1. Tens"
    },
    {
      "type": "table",
      "rows": [
        [
          "20 twenty",
          "30 thirty",
          "40 forty"
        ],
        [
          "50 fifty",
          "60 sixty",
          "70 seventy"
        ],
        [
          "80 eighty",
          "90 ninety",
          "100 one hundred"
        ]
      ]
    },
    {
      "type": "rule",
      "title": "Spelling",
      "points": [
        "Tens end in -ty.",
        "four → forty (no u)",
        "five → fifty, three → thirty, eight → eighty"
      ]
    },
    {
      "type": "heading",
      "text": "2. Numbers like 34"
    },
    {
      "type": "rule",
      "title": "Tens + number",
      "points": [
        "Write a hyphen (-) between them: 34 = thirty-four, 99 = ninety-nine.",
        "100 = one hundred or a hundred."
      ]
    },
    {
      "type": "heading",
      "text": "3. -teen or -ty?"
    },
    {
      "type": "table",
      "header": true,
      "rows": [
        [
          "-teen",
          "-ty"
        ],
        [
          "13 thirteen",
          "30 thirty"
        ],
        [
          "14 fourteen",
          "40 forty"
        ],
        [
          "15 fifteen",
          "50 fifty"
        ]
      ]
    },
    {
      "type": "tip",
      "text": "Stress: thir-TEEN, but THIR-ty."
    },
    {
      "type": "heading",
      "text": "4. Grammar focus"
    },
    {
      "type": "rule",
      "title": "Plural nouns and prices",
      "points": [
        "After numbers use a plural noun: 25 students, 60 minutes.",
        "Prices: 40 dollars, 75 cents."
      ]
    },
    {
      "type": "heading",
      "text": "Be careful!"
    },
    {
      "type": "mistake",
      "wrong": "fourty",
      "right": "forty"
    },
    {
      "type": "mistake",
      "wrong": "thirty four",
      "right": "thirty-four",
      "why": "Use a hyphen."
    },
    {
      "type": "mistake",
      "wrong": "one hundred student",
      "right": "one hundred students"
    }
  ],
  "exercises": [
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "Tens end in -ty.",
      "content": {
        "type": "match_pairs",
        "payload": {
          "left": [
            "30",
            "40",
            "50",
            "80"
          ],
          "right": [
            "forty",
            "fifty",
            "eighty",
            "thirty"
          ],
          "instruction": "Match the number and the word."
        },
        "answer": {
          "pairs": [
            3,
            0,
            1,
            2
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "50 is fifty. 15 is fifteen.",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "Which is 50?",
          "options": [
            {
              "text": "fifteen"
            },
            {
              "text": "fifty"
            },
            {
              "text": "five"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
    {
