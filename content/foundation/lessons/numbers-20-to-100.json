        ],
        [
          "50 fifty",
          "60 sixty",
          "70 seventy"
        ],
        [
          "80 eighty",
          "90 ninety",
          "100 one hundred"
        ]
      ]
    },
    {
      "type": "text",
      "text": "Tens end in -ty."
    },
    {
      "type": "example",
      "en": "34 = thirty-four",
      "note": "tens + number"
    },
    {
      "type": "example",
      "en": "99 = ninety-nine"
    },
    {
      "type": "tip",
      "text": "Forty has no u: four → forty."
    },
    {
      "type": "tip",
      "text": "Fifteen (15) and fifty (50) are different numbers."
    }
  ],
  "exercises": [
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "Tens end in -ty.",
      "content": {
        "type": "match_pairs",
        "payload": {
          "left": [
            "30",
            "40",
            "50",
            "80"
          ],
          "right": [
            "forty",
            "fifty",
            "eighty",
            "thirty"
          ],
          "instruction": "Match the number and the word."
        },
        "answer": {
          "pairs": [
            3,
            0,
            1,
            2
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "50 is fifty. 15 is fifteen.",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "Which is 50?",
          "options": [
            {
              "text": "fifteen"
            },
            {
              "text": "fifty"
            },
            {
              "text": "five"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
    {
      "skill": "vocabulary",
      "cefr": "A1",
      "explanation": "Forty has no u.",
      "content": {
        "type": "mcq",
        "payload": {
          "prompt": "Which is spelled correctly?",
          "options": [
            {
              "text": "fourty"
            },
            {
              "text": "forty"
            },
            {
              "text": "forthy"
            }
          ]
        },
        "answer": {
          "correct": [
            1
          ]
        }
      }
    },
    {
