{
  "title": "How much? How many?",
  "kind": "grammar",
  "cefr": "A1",
  "estMinutes": 7,
  "intro": [
    {
      "type": "text",
      "text": "How many + things we can count."
    },
    {
      "type": "example",
      "en": "How many apples do you want?"
    },
    {
      "type": "text",
      "text": "How much + things we cannot count."
    },
    {
      "type": "example",
      "en": "How much water do you drink?"
    },
    {
      "type": "text",
      "text": "We also use How much for prices."
    },
    {
      "type": "example",
      "en": "How much is it? — It's five dollars."
    },
    {
      "type": "example",
      "en": "How much are the shoes? — They're thirty dollars."
    }
  ],
  "exercises": [
