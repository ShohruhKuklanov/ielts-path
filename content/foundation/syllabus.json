{
  "stage": "foundation",
  "modules": [
    {
      "title": "Letters and sounds",
      "icon": "text",
      "lessons": [
        {
          "title": "The alphabet: A to M",
          "kind": "alphabet",
          "cefr": "A0",
          "goals": [
            "Say and recognise the letters A–M",
            "Match capital and small letters"
          ],
          "targetLanguage": [
            "A a",
            "B b",
            "C c",
            "D d",
            "E e",
            "F f",
            "G g",
            "H h",
            "I i",
            "J j",
            "K k",
            "L l",
            "M m"
          ]
        },
        {
          "title": "The alphabet: N to Z",
          "kind": "alphabet",
          "cefr": "A0",
          "goals": [
            "Say and recognise the letters N–Z",
            "Say the whole alphabet in order"
          ],
          "targetLanguage": [
            "N n",
            "O o",
            "P p",
            "Q q",
            "R r",
            "S s",
            "T t",
            "U u",
            "V v",
            "W w",
            "X x",
            "Y y",
            "Z z"
          ]
        },
        {
          "title": "Spell your name",
          "kind": "alphabet",
          "cefr": "A0",
          "goals": [
            "Spell a name letter by letter",
            "Ask: How do you spell that?"
          ],
          "targetLanguage": [
            "How do you spell your name?",
            "My name is …"
          ]
        },
        {
          "title": "Short vowel sounds",
          "kind": "phonics",
          "cefr": "A0",
          "goals": [
            "Hear and say short a, e, i, o, u",
            "Tell apart pairs like bag/beg, ship/shop"
          ],
          "targetLanguage": [
            "cat",
            "bed",
            "sit",
            "hot",
            "cup",
            "bag",
            "beg",
            "ship",
            "shop"
          ]
        },
        {
          "title": "Long vowel sounds",
          "kind": "phonics",
          "cefr": "A0",
          "goals": [
            "Hear and say long vowels: see, car, blue, door, bird",
            "Tell apart ship/sheep, full/fool"
          ],
          "targetLanguage": [
            "see",
            "sheep",
            "car",
            "blue",
            "food",
            "door",
            "bird"
          ]
        },
        {
          "title": "Numbers 1 to 20",
          "kind": "vocabulary",
          "cefr": "A0",
          "goals": [
            "Say and write numbers 1–20",
            "Understand numbers when you hear them"
          ],
          "targetLanguage": [
            "one",
            "two",
            "three",
            "ten",
            "eleven",
            "twelve",
            "thirteen",
            "twenty"
          ]
        }
      ]
    },
    {
      "title": "Hello!",
      "icon": "hand-left",
      "lessons": [
        {
          "title": "Hello and goodbye",
          "kind": "vocabulary",
          "cefr": "A0",
          "goals": [
            "Greet people and say goodbye",
            "Use Good morning / afternoon / evening"
          ],
          "targetLanguage": [
            "hello",
            "hi",
            "goodbye",
            "bye",
            "good morning",
            "good afternoon",
            "good evening",
            "nice to meet you"
          ]
        },
        {
          "title": "I am, you are",
          "kind": "grammar",
          "cefr": "A0",
          "goals": [
            "Use I am / you are in positive sentences",
            "Use short forms I'm / you're"
          ],
          "targetLanguage": [
            "I am",
            "I'm",
            "you are",
            "you're"
          ]
        },
        {
          "title": "Where are you from?",
          "kind": "vocabulary",
          "cefr": "A0",
          "goals": [
            "Name 10 countries",
            "Ask and answer: Where are you from? I'm from …"
          ],
          "targetLanguage": [
            "Uzbekistan",
            "Kazakhstan",
            "Russia",
            "Turkey",
            "China",
            "India",
            "the UK",
            "the USA",
            "Japan",
            "Korea"
          ]
        },
        {
          "title": "Numbers 20 to 100",
          "kind": "vocabulary",
          "cefr": "A1",
          "goals": [
            "Say and write tens: twenty to one hundred",
            "Say numbers like 34 and 99"
          ],
          "targetLanguage": [
            "thirty",
            "forty",
            "fifty",
            "sixty",
            "seventy",
            "eighty",
            "ninety",
            "one hundred"
          ]
        },
        {
          "title": "Is it? Are you? Questions with be",
          "kind": "grammar",
          "cefr": "A0",
          "goals": [
            "Make yes/no questions with be",
            "Give short answers: Yes, I am. / No, I'm not."
          ],
          "targetLanguage": [
            "Are you …?",
            "Is it …?",
            "Yes, I am.",
            "No, I'm not."
          ]
        },
        {
          "title": "Review: Hello!",
          "kind": "review",
          "cefr": "A0",
          "goals": [
            "Review greetings, I am / you are, countries and numbers"
          ]
        }
      ]
    },
    {
      "title": "People and things",
      "icon": "cube",
      "lessons": [
        {
          "title": "A or an?",
          "kind": "grammar",
          "cefr": "A0",
          "goals": [
            "Use a before consonant sounds and an before vowel sounds",
            "Name everyday objects with a/an"
          ],
          "targetLanguage": [
            "a book",
            "a pen",
            "an apple",
            "an egg",
            "an umbrella",
            "a bag"
          ]
        },
        {
          "title": "He is, she is, it is",
          "kind": "grammar",
          "cefr": "A0",
          "goals": [
            "Use he / she / it with is",
            "Use short forms he's / she's / it's"
          ],
          "targetLanguage": [
            "he is",
            "she is",
            "it is",
            "he's",
            "she's",
            "it's"
          ]
        },
        {
          "title": "One book, two books",
          "kind": "grammar",
          "cefr": "A0",
          "goals": [
            "Make regular plurals with -s and -es",
            "Learn common irregular plurals"
          ],
          "targetLanguage": [
            "books",
            "boxes",
            "buses",
            "children",
            "men",
            "women",
            "people"
          ]
        },
        {
          "title": "This, that, these, those",
          "kind": "grammar",
          "cefr": "A1",
          "goals": [
            "Point to near and far things",
            "Use this/that with one thing and these/those with more"
          ],
          "targetLanguage": [
            "this",
            "that",
            "these",
            "those"
          ]
        },
        {
          "title": "Colours and everyday things",
          "kind": "vocabulary",
          "cefr": "A0",
          "goals": [
            "Name 10 colours",
            "Describe objects: a red bag"
          ],
          "targetLanguage": [
            "red",
            "blue",
            "green",
            "yellow",
            "black",
            "white",
            "brown",
            "orange",
            "pink",
            "grey"
          ]
        },
        {
          "title": "We are, they are",
          "kind": "grammar",
          "cefr": "A0",
          "goals": [
            "Use we / they with are",
            "Make negatives: isn't / aren't"
          ],
          "targetLanguage": [
            "we are",
            "they are",
            "isn't",
            "aren't"
          ]
        }
      ]
    },
    {
      "title": "My family and me",
