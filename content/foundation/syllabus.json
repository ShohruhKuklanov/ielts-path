          "title": "Don't and doesn't",
          "kind": "grammar",
          "cefr": "A1",
          "goals": [
            "Make negative present simple sentences"
          ],
          "targetLanguage": [
            "don't",
            "doesn't"
          ]
        },
        {
          "title": "Do you…? Does she…?",
          "kind": "grammar",
          "cefr": "A1",
          "goals": [
            "Make present simple questions and short answers"
          ],
          "targetLanguage": [
            "Do you …?",
            "Does he …?",
            "Yes, I do.",
            "No, she doesn't."
