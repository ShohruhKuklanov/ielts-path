// Turns the reviewed content files (content/<stage>/syllabus.json + lessons/*.json)
// into idempotent SQL: supabase/seed.sql. Safe to run again and again:
// existing modules and lessons are kept, and a lesson's intro and exercises are
// only filled in while the lesson is still an empty draft.
//
//   pnpm content:build   → validate files + write supabase/seed.sql
//   pnpm content:load    → the same, then load it into the local database
import { readdirSync, readFileSync, writeFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { lessonFileSchema, syllabusSchema, type LessonFile } from '../packages/shared/src/index.ts';

const ROOT = fileURLToPath(new URL('..', import.meta.url));
const CONTENT = join(ROOT, 'content');
const OUT = join(ROOT, 'supabase', 'seed.sql');

const q = (s: string) => {
  if (s.includes('$c$')) throw new Error(`Text contains the SQL quote marker $c$: ${s}`);
  return `$c$${s}$c$`;
};
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;
const textArray = (a: readonly string[]) => (a.length ? `array[${a.map(q).join(', ')}]::text[]` : `'{}'::text[]`);
const fail = (msg: string): never => {
  console.error(`\n✖ ${msg}\n`);
  process.exit(1);
};

const out: string[] = [
  '-- GENERATED by scripts/build-content-sql.mts from content/. Do not edit by hand.',
  '-- Idempotent: safe to run on a database that already has this content.',
  'begin;',
];
let lessonCount = 0;
let writtenCount = 0;
let exerciseCount = 0;

const stages = readdirSync(CONTENT, { withFileTypes: true }).filter((d) => d.isDirectory());
for (const stage of stages) {
  const dir = join(CONTENT, stage.name);
  const syl = syllabusSchema.safeParse(JSON.parse(readFileSync(join(dir, 'syllabus.json'), 'utf8')));
  if (!syl.success) fail(`${stage.name}/syllabus.json: ${syl.error.issues.map((i) => `${i.path.join('.')}: ${i.message}`).join('; ')}`);
  const syllabus = syl.data!;

  // Lesson files, matched to the syllabus by title.
  const files = new Map<string, LessonFile>();
  const lessonsDir = join(dir, 'lessons');
  if (existsSync(lessonsDir))
    for (const f of readdirSync(lessonsDir).filter((n) => n.endsWith('.json'))) {
      const r = lessonFileSchema.safeParse(JSON.parse(readFileSync(join(lessonsDir, f), 'utf8')));
      if (!r.success) fail(`${stage.name}/lessons/${f}: ${r.error.issues.map((i) => `${i.path.join('.')}: ${i.message}`).join('; ')}`);
      files.set(r.data!.title, r.data!);
    }
  const planned = new Set(syllabus.modules.flatMap((m) => m.lessons.map((l) => l.title)));
  for (const title of files.keys()) if (!planned.has(title)) fail(`Lesson file "${title}" is not in ${stage.name}/syllabus.json`);

  out.push('', `-- ===== ${syllabus.stage} =====`);
  syllabus.modules.forEach((mod, mi) => {
    const m = mi + 1;
    out.push(
      '',
      `insert into public.modules (stage_id, order_index, title, icon)`,
      `select s.id, ${m}, ${q(mod.title)}, ${mod.icon ? q(mod.icon) : 'null'} from public.stages s where s.code = ${q(syllabus.stage)}`,
      `on conflict (stage_id, order_index) do nothing;`,
    );
    const moduleRef = `(select m.id from public.modules m join public.stages s on s.id = m.stage_id where s.code = ${q(syllabus.stage)} and m.order_index = ${m})`;

    mod.lessons.forEach((les, li) => {
      const l = li + 1;
      lessonCount++;
      out.push(
        `insert into public.lessons (module_id, order_index, title, kind, cefr, goals, target_language, status)`,
        `select ${moduleRef}, ${l}, ${q(les.title)}, ${q(les.kind)}, ${q(les.cefr)}, ${textArray(les.goals)}, ${textArray(les.targetLanguage ?? [])}, 'draft'`,
        `on conflict (module_id, order_index) do nothing;`,
      );

      const file = files.get(les.title);
      if (!file) return;
      writtenCount++;
      const lessonRef = `(select id from public.lessons where module_id = ${moduleRef} and order_index = ${l})`;
      out.push(
        `-- written lesson: fill it only while it is still an empty draft`,
        `update public.lessons set intro = ${json(file.intro)}, est_minutes = ${file.estMinutes}, cefr = ${q(file.cefr)}, status = 'in_review', source = 'human'`,
        `where id = ${lessonRef} and status = 'draft' and not exists (select 1 from public.exercises e where e.lesson_id = ${lessonRef});`,
      );
      const rows = file.exercises.map((ex, ei) => {
        exerciseCount++;
        return `  (${ei + 1}, ${q(ex.content.type)}, ${q(ex.skill)}::public.skill, ${q(ex.cefr)}::public.cefr, ${ex.questionTypeTag ? q(ex.questionTypeTag) : 'null'}, ${json(ex.content.payload)}, ${json(ex.content.answer)}, ${ex.explanation ? q(ex.explanation) : 'null'})`;
      });
      out.push(
        `insert into public.exercises (lesson_id, order_index, type, skill, cefr, question_type_tag, payload, answer, explanation, status, source)`,
        `select ${lessonRef}, v.ord, v.type, v.skill, v.cefr, v.tag, v.payload, v.answer, v.expl, 'in_review', 'human'`,
        `from (values`,
        rows.join(',\n'),
        `) as v(ord, type, skill, cefr, tag, payload, answer, expl)`,
        `where not exists (select 1 from public.exercises e where e.lesson_id = ${lessonRef});`,
      );
    });
  });
}
out.push('', 'commit;', '');
writeFileSync(OUT, out.join('\n'));
console.log(`✔ supabase/seed.sql: ${lessonCount} lessons planned, ${writtenCount} written, ${exerciseCount} exercises`);
